# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database. Locally: the embedded server from `npm run db:start`.
# On Supabase: the project's direct connection (or the session pooler if IPv6 isn't
# available), with ?sslmode=require, and PG_EMBEDDED=0.
# Tests always use the embedded server on PG_PORT, whatever DATABASE_URL says.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/salescrm
# DATABASE_URL=postgres://postgres:<db password, url-encoded>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# PG_EMBEDDED=0
PG_DATA_DIR=.local/pgdata
PG_PORT=54329

# ---------------------------------------------------------------------------
# Sign-in. local = password hashes in the auth.users shim (dev and tests).
# supabase = Supabase Auth (email + password), needs SUPABASE_URL and SUPABASE_ANON_KEY.
# ---------------------------------------------------------------------------
AUTH_PROVIDER=local
# At least 32 random characters: `openssl rand -base64 48`. Also encrypts the Supabase token cookie.
SESSION_SECRET=

# Supabase project (public values; the app never uses a service-role key).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# For `npm run supabase:*` (migrations, creating users). Keep private.
# SUPABASE_DB_HOST=db.<project-ref>.supabase.co
# SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Files. local = UPLOAD_DIR on this machine; supabase = the private crm-files bucket.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=.local/uploads

# AI adapters (import extraction, script drafting, research agent) ship disabled.
AI_PROVIDER=none
