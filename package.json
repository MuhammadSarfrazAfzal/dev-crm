{
  "name": "sales-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3020",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:status": "tsx scripts/db.ts status",
    "db:pull": "tsx scripts/pull-prod.ts",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "supabase:migrate": "tsx scripts/supabase.ts migrate",
    "supabase:status": "tsx scripts/supabase.ts status",
    "supabase:create-user": "tsx scripts/supabase.ts create-user",
    "supabase:default-scripts": "tsx scripts/supabase.ts default-scripts",
    "import:bench": "tsx scripts/import-bench.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@supabase/realtime-js": "2.117.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "mammoth": "^1.13.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@17.10.0-beta.17": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "tesseract.js": false
  }
}
